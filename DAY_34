#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct Node {
    int data;
    struct Node* next;
} Node;

Node* top = NULL;

void push(int x) {
    Node* temp = (Node*)malloc(sizeof(Node));
    temp->data = x;
    temp->next = top;
    top = temp;
}

int pop() {
    Node* temp = top;
    int val = temp->data;
    top = top->next;
    free(temp);
    return val;
}

int main() {
    char expr[100];
    scanf("%[^\n]", expr);

    char* token = strtok(expr, " ");

    while (token != NULL) {
        if (strlen(token) == 1 && 
           (token[0] == '+' || token[0] == '-' || token[0] == '*' || token[0] == '/')) {

            int b = pop();
            int a = pop();
            int res;

            if (token[0] == '+') res = a + b;
            else if (token[0] == '-') res = a - b;
            else if (token[0] == '*') res = a * b;
            else res = a / b;

            push(res);
        } else {
            push(atoi(token));
        }

        token = strtok(NULL, " ");
    }

    printf("%d", pop());

    return 0;
}
